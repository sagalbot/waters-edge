{
  "name": "waters-edge",
  "compatibility_date": "2026-10-29",
  "main": "worker.ts",
  "assets": {
    "directory": "./dist"
  },
  // Contact form email (see worker.ts). TURNSTILE_SECRET is a secret: `npx wrangler secret put TURNSTILE_SECRET`.
