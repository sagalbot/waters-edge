---
// Served with a 404 status for any unknown URL (not_found_handling in wrangler.jsonc).
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import { BOOKING_URL, NAV } from "../site";
---

<Base title="Page Not Found | Water's Edge" description="This page doesn't exist on the Water's Edge Massage Therapy site.">
  <PageHero eyebrow="404" title="Page Not Found">
    <a class="button" href={BOOKING_URL}>Book</a>
  </PageHero>

  <section class="missing container section">
    <p class="lead">The page you're looking for isn't here.</p>
    <ul>
      <li><a class="text-link" href="/">Home <span aria-hidden="true">→</span></a></li>
      {NAV.map((l) => <li><a class="text-link" href={l.href}>{l.label} <span aria-hidden="true">→</span></a></li>)}
    </ul>
  </section>
</Base>

<style>
  .lead {
    font-family: var(--serif);
    font-size: clamp(1.625rem, 2.6vw, 2.25rem);
    line-height: 1.25;
    color: var(--cedar);
    margin: 0 0 2rem;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 3rem;
  }
</style>
