---
import { getCollection, render } from "astro:content";
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import Mark from "../../brand/logo/mark-cedar.svg";
import { BOOKING_URL } from "../site";

const focus = await Promise.all(
  (await getCollection("focus"))
    .sort((a, b) => a.data.order - b.data.order)
    .map(async (f) => ({
      ...f,
      Content: (await render(f)).Content,
    })),
);
---

<Base
  title="Services | Water's Edge Massage Therapy"
  description="Therapeutic massage for injury recovery, relaxation massage for nervous system regulation, and focused treatments for chronic pain, TMJ dysfunction, stress-related tension, and sports injuries."
>
  <PageHero eyebrow="Services" title="Our Services" />

  <section class="services container section">
    <div class="services__copy">
      <p class="lead">
        Alexis offers professional massage therapy designed to help relieve pain, reduce stress, and improve overall
        physical function. Each treatment is customized to meet your unique needs and goals, delivered in a safe and
        calming environment.
      </p>
      <p>
        Services include therapeutic massage for injury recovery, relaxation massage for nervous system regulation, and
        focused treatments for conditions such as chronic pain, TMJ dysfunction, stress-related tension, and sports
        injuries. Alexis has a special interest in working with individuals managing anxiety, persistent pain, and
        TMJ-related concerns.
      </p>
      <p>
        Whether you're seeking support for a specific condition or looking to improve your general well-being,
        treatments are grounded in evidence-informed practice and a patient-centered approach that prioritizes comfort,
        trust, and lasting results.
      </p>
      <p class="services__actions">
        <a class="button" href={BOOKING_URL}>Book now</a>
        <a class="text-link" href="/rates">Rates <span aria-hidden="true">→</span></a>
      </p>
    </div>
    <Mark class="services__mark" aria-hidden="true" role="presentation" />
  </section>

  <section class="focus container section" aria-labelledby="focus-title">
    <h2 id="focus-title" class="eyebrow">Focus Areas</h2>
    <ul>
      {
        focus.map(({ id, data, Content }) => (
          <li id={id}>
            <h3>
              {data.title}
              {data.subtitle && <span class="focus__subtitle">{data.subtitle}</span>}
            </h3>
            <div class="focus__body"><Content /></div>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  .services {
    display: grid;
    grid-template-columns: 7fr 4fr;
    gap: 3rem clamp(3rem, 8vw, 8rem);
    align-items: center;
  }
  .services__copy {
    max-width: 38rem;
  }
  .services__copy p {
    margin: 0 0 1.5em;
  }
  .services__copy .lead {
    font-family: var(--serif);
    font-size: clamp(1.625rem, 2.6vw, 2.25rem);
    line-height: 1.25;
    color: var(--cedar);
  }
  .services__copy .services__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 2.5rem;
    margin-top: 2.5rem;
  }
  .services__mark {
    width: 100%;
    max-width: 22rem;
    height: auto;
    justify-self: center;
    opacity: 0.85;
  }
  .focus {
    padding-top: 0;
  }
  .focus .eyebrow {
    margin: 0 0 2rem;
  }
  .focus ul {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }
  .focus li {
    display: grid;
    grid-template-columns: 4fr 7fr;
    gap: 1rem clamp(3rem, 8vw, 8rem);
    padding: 1.75rem 0;
    border-bottom: 1px solid var(--rule);
    scroll-margin-top: 6rem;
  }
  .focus h3 {
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    color: var(--cedar);
  }
  .focus__subtitle {
    display: block;
    margin-top: 0.5rem;
    font-family: var(--sans);
    font-size: 0.75rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .focus__body {
    max-width: 38rem;
  }
  .focus__body :global(p) {
    margin: 0 0 1em;
  }
  .focus__body :global(p:last-child) {
    margin-bottom: 0;
  }
  @media (max-width: 860px) {
    .focus li {
      grid-template-columns: 1fr;
    }
    .services {
      grid-template-columns: 1fr;
    }
    .services__mark {
      max-width: 10rem;
      justify-self: start;
      order: -1;
    }
  }
</style>
