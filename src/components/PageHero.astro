---
// Cedar title band for inner pages, closed by the ridgeline like the home hero.
// The headline and ridgeline carry the page-to-page transition (see src/transitions.ts).
import HeroRidge from "./HeroRidge.astro";
import { wash } from "../transitions";

interface Props {
  eyebrow: string;
  title: string;
}
const { eyebrow, title } = Astro.props;
---

<section class="page-hero" transition:name="hero">
  <div class="container">
    <p class="eyebrow" transition:name="hero-eyebrow" transition:animate={wash}>{eyebrow}</p>
    <h1 transition:name="hero-title" transition:animate={wash}>{title}</h1>
  </div>
  <HeroRidge />
</section>

<style>
  .page-hero {
    position: relative;
    overflow: hidden;
    background: var(--cedar);
    color: var(--cream);
    padding: clamp(4rem, 9vw, 7rem) 0 clamp(7rem, 13vw, 11rem);
  }
  h1 {
    font-size: clamp(2.75rem, 6vw, 5.25rem);
    margin-top: 1.5rem;
    max-width: 16ch;
  }
</style>
