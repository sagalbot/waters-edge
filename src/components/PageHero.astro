---
// Cedar title band for inner pages, closed by the ridgeline like the home hero.
// The headline and ridgeline carry the page-to-page transition (see src/transitions.ts).
import HeroRidge from "./HeroRidge.astro";
import { tide, wash } from "../transitions";

interface Props {
  eyebrow: string;
  title: string;
}
const { eyebrow, title } = Astro.props;
---

<section class="page-hero" transition:name="hero" transition:animate={tide}>
  <div class="container">
    <p class="eyebrow" transition:name="hero-eyebrow" transition:animate={wash}>{eyebrow}</p>
    <h1 transition:name="hero-title" transition:animate={wash}>{title}</h1>
  </div>
  <HeroRidge />
</section>

<style>
  .page-hero {
    position: relative;
    overflow: hidden;
    background: var(--cedar);
    color: var(--cream);
    /* Room below the headline for the ridge and its waves (see global.css). */
    padding: clamp(4rem, 9vw, 7rem) 0 calc(var(--ridge-rise) + var(--ridge-gap));
  }
  h1 {
    font-size: clamp(2.75rem, 6vw, 5.25rem);
    margin-top: 1.5rem;
    max-width: 16ch;
    /* Keeps descenders inside the box the transition wash masks. */
    padding-bottom: 0.2em;
    margin-bottom: -0.2em;
  }
</style>
