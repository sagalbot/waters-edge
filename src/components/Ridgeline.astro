---
// The skyline contour lines (see src/ridge.ts). Rendered still on the server; a single
// clock animates every ridgeline on the page. An optional fill under the ridge lets a
// panel rise into a photo; its opacity comes from --ridge-fill (see styles/global.css).
import { contourPath, fillPath } from "../ridge";

interface Props {
  lines?: number;
}
const { lines = 4 } = Astro.props;
const paths = Array.from({ length: lines }, (_, k) => contourPath(k));
---

<svg class="ridgeline" viewBox="0 0 1440 220" preserveAspectRatio="none" aria-hidden="true">
  <path class="ridge-fill" d={fillPath(paths[0])} />
  {paths.map((d, k) => <path class="ridge-line" d={d} style={`--k:${k}`} vector-effect="non-scaling-stroke" />)}
</svg>

<script>
  import { contourPath, fillPath } from "../ridge";

  // Time is shared by every ridgeline, so the hero ridge (which persists across
  // navigations) never jumps. Each ridgeline eases its swell in from stillness the
  // first time it appears, so nothing pops. Ridgelines out of view are not redrawn.
  const born = new Map<SVGSVGElement, number>();
  const visible = new Set<SVGSVGElement>();
  const seen = new IntersectionObserver((entries) => {
    for (const e of entries) {
      const svg = e.target as SVGSVGElement;
      if (e.isIntersecting) visible.add(svg);
      else visible.delete(svg);
    }
  });
  const still = matchMedia("(prefers-reduced-motion: reduce)");

  function collect() {
    const now = performance.now();
    document.querySelectorAll<SVGSVGElement>("svg.ridgeline").forEach((svg) => {
      if (born.has(svg)) return;
      born.set(svg, now);
      seen.observe(svg);
    });
  }

  function frame(now: number) {
    const t = now / 1000;
    for (const [svg, start] of born) {
      if (!svg.isConnected) {
        born.delete(svg);
        visible.delete(svg);
        seen.unobserve(svg);
        continue;
      }
      if (!visible.has(svg)) continue;
      const p = Math.min(1, (now - start) / 3000);
      const swell = p * p * (3 - 2 * p);
      svg.querySelectorAll("path.ridge-line").forEach((path, k) => {
        const d = contourPath(k, t, swell);
        path.setAttribute("d", d);
        if (k === 0) svg.querySelector("path.ridge-fill")?.setAttribute("d", fillPath(d));
      });
    }
    requestAnimationFrame(frame);
  }

  // The hero ridge is carried over to the next page, where its fill may differ (the
  // home hero hides it over the photo on wide screens). Fade between the two during the
  // page transition rather than switching it on the first frame.
  document.addEventListener("astro:before-swap", (event) => {
    const before = new Map<Element, string>();
    document.querySelectorAll(".ridge-slot .ridge-fill").forEach((f) => before.set(f, getComputedStyle(f).fillOpacity));
    // Start with the transition's own animations so the two stay in step.
    event.viewTransition.ready.then(() => {
      const easing = getComputedStyle(document.documentElement).getPropertyValue("--tide-ease") || "ease";
      for (const [fill, from] of before) {
        const to = getComputedStyle(fill).fillOpacity;
        if (fill.isConnected && from !== to && !still.matches) {
          fill.animate({ fillOpacity: [from, to] }, { duration: 900, easing });
        }
      }
    }, () => {});
  });

  document.addEventListener("astro:page-load", collect);
  if (!still.matches) requestAnimationFrame(frame);
</script>

<style>
  .ridgeline {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
  }
  .ridge-line {
    stroke-width: calc(1.5px - var(--k) * 0.2px);
    opacity: calc(1 - var(--k) * 0.18);
  }
  .ridge-fill {
    fill: var(--cedar);
    stroke: none;
    fill-opacity: var(--ridge-fill, 0);
  }
</style>
