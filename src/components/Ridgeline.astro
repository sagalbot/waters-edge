---
// The North Shore skyline as nested contour lines: the Lions on the left, Grouse and
// Fromme in the middle, Seymour on the right. The top line is the ridge; each line
// below it is a lower contour, flatter and lower on the page. An optional fill under
// the ridge (shown only where a hero turns it on) lets a panel rise into a photo.
interface Props {
  lines?: number;
}
const { lines = 4 } = Astro.props;

const ridge: [number, number][] = [
  [-20, 150], [90, 130], [160, 104], [208, 80], [234, 92], [258, 76], [310, 100],
  [380, 112], [470, 86], [560, 60], [640, 72], [720, 98], [800, 90], [880, 66],
  [960, 54], [1040, 76], [1120, 102], [1200, 84], [1290, 72], [1370, 98], [1460, 120],
];

// Closed-form Catmull-Rom -> cubic Bezier for an open polyline.
function smooth(pts: [number, number][]) {
  const f = (n: number) => n.toFixed(1);
  let d = `M${f(pts[0][0])} ${f(pts[0][1])}`;
  for (let i = 0; i < pts.length - 1; i++) {
    const p0 = pts[Math.max(i - 1, 0)], p1 = pts[i], p2 = pts[i + 1], p3 = pts[Math.min(i + 2, pts.length - 1)];
    const c1 = [p1[0] + (p2[0] - p0[0]) / 6, p1[1] + (p2[1] - p0[1]) / 6];
    const c2 = [p2[0] - (p3[0] - p1[0]) / 6, p2[1] - (p3[1] - p1[1]) / 6];
    d += `C${f(c1[0])} ${f(c1[1])} ${f(c2[0])} ${f(c2[1])} ${f(p2[0])} ${f(p2[1])}`;
  }
  return d;
}

const paths = Array.from({ length: lines }, (_, k) =>
  smooth(ridge.map(([x, y]) => [x, 175 + k * 12 - (175 - y) * (1 - 0.24 * k)])),
);
---

<svg class="ridgeline" viewBox="0 0 1440 220" preserveAspectRatio="none" aria-hidden="true">
  <path class="ridge-fill" d={`${paths[0]}L1460 240L-20 240Z`} />
  {paths.map((d, k) => (
    <path d={d} pathLength="1" style={`--k:${k}`} vector-effect="non-scaling-stroke" />
  ))}
</svg>

<style>
  .ridgeline {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
  }
  path {
    stroke-width: calc(1.5px - var(--k) * 0.25px);
    opacity: calc(1 - var(--k) * 0.22);
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation:
      draw 2.8s cubic-bezier(0.4, 0, 0.2, 1) calc(0.3s + var(--k) * 0.25s) forwards,
      drift calc(18s + var(--k) * 6s) ease-in-out calc(3s + var(--k) * 0.25s) infinite alternate;
  }
  .ridge-fill {
    display: none;
    fill: var(--cedar);
    stroke: none;
    opacity: 1;
    animation: drift 18s ease-in-out 3s infinite alternate;
  }
  @keyframes draw {
    to { stroke-dashoffset: 0; }
  }
  @keyframes drift {
    from { transform: translateX(0); }
    to { transform: translateX(calc(8px + var(--k) * 4px)); }
  }
  @media (prefers-reduced-motion: reduce) {
    path,
    .ridge-fill {
      animation: none;
      stroke-dashoffset: 0;
    }
  }
</style>
