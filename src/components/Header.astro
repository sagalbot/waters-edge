---
import Logo from "../../brand/logo/logo-horizontal-cedar.svg";
import { BOOKING_URL, NAV } from "../site";
import { toggleLine } from "../menu-shapes";

const current = (href: string) => (Astro.url.pathname.replace(/\/$/, "") === href ? "page" : undefined);
---

<header class="site-header" transition:name="site-header" transition:animate="none">
  <div class="container site-header__inner">
    <a href="/" class="site-header__logo"><Logo /></a>
    <nav aria-label="Main">
      <ul class="site-header__nav">
        {NAV.map((l) => <li><a href={l.href} aria-current={current(l.href)}>{l.label}</a></li>)}
      </ul>
    </nav>
    <a class="button" href={BOOKING_URL}>Book now</a>
    <!-- Opens the drawer in MobileMenu.astro. Persisted so its lines can finish
         rippling back while the next page arrives. -->
    <button
      class="menu-toggle"
      type="button"
      aria-label="Menu"
      aria-expanded="false"
      aria-controls="menu-drawer"
      transition:persist="menu-toggle"
    >
      <svg viewBox="-12 -12 24 24" aria-hidden="true">
        <path d={toggleLine(-1, 0)}></path>
        <path d={toggleLine(1, 0)}></path>
      </svg>
    </button>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--cream) 92%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--rule);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    gap: 2.5rem;
    height: 5rem;
  }
  .site-header__logo {
    margin-right: auto;
    line-height: 0;
  }
  .site-header__logo :global(svg) {
    height: 2.75rem;
    width: auto;
  }
  .site-header__nav {
    display: flex;
    gap: 2.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .site-header__nav a {
    color: var(--ink);
    text-decoration: none;
    font-size: 0.9375rem;
    letter-spacing: 0.02em;
  }
  .site-header__nav a:hover {
    color: var(--moss);
  }
  .site-header__nav a[aria-current="page"] {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.5em;
  }
  .menu-toggle {
    display: none;
    width: 2.75rem;
    height: 2.75rem;
    margin-right: -0.6rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink);
    cursor: pointer;
  }
  .menu-toggle svg {
    width: 1.6rem;
    height: 1.6rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    overflow: visible;
  }
  @media (max-width: 860px) {
    .site-header__inner {
      gap: 1.25rem;
      height: 4.25rem;
    }
    .site-header__logo :global(svg) {
      height: 2.25rem;
    }
    .button {
      padding: 0.55rem 1.1rem;
      font-size: 0.875rem;
    }
    nav {
      display: none;
    }
    .menu-toggle {
      display: grid;
      place-items: center;
    }
  }
</style>
